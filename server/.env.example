# Copy this file to `server/.env` and fill in the real values there.
# `server/.env` is git-ignored and must never be committed, printed in logs,
# or bundled into the Flutter app.
#
# ---------------------------------------------------------------------------
# HUMAIN Voice (server-side only)
# ---------------------------------------------------------------------------
# Get the key from https://console.voice.humain.com -> API keys -> New key.
# A key works only with the API_URL of the environment that issued it.
# Read the docs' own instructions: keep the key out of source control, URLs and logs.
HUMAIN_API_KEY=
# Local development should never spend provider credits by accident.
# The production config rejects this value; explicitly select the real provider there.
VOICE_PROVIDER=mock

# Environment API origin that issued the key. Default below is the documented one.
HUMAIN_API_URL=https://api.voice.humain.com

# Socket.IO path. Defaults to /socket.io for every Socket.IO workflow.
# The voice list is only reachable over Socket.IO (there is no HTTP voice-list
# route), so the adapter needs this for voice-ID resolution.
HUMAIN_API_PATH=/socket.io

# Batch REST version. Defaults to v1.
HUMAIN_API_VERSION=v1

# ---------------------------------------------------------------------------
# Backend (our own service)
# ---------------------------------------------------------------------------
# MUST be changed from the placeholder before anything is deployed.
PORT=8080
NODE_ENV=development
# Signs backend access tokens in both local and Supabase-backed modes.
# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
LOCAL_JWT_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
# Exact browser origins allowed by CORS, comma-separated. Development defaults
# to localhost/127.0.0.1:5173; production web clients must use HTTPS origins.
CORS_ALLOWED_ORIGINS=

# Resend email verification and password recovery (production requires these).
# Verify the sender domain in Resend before using it. Never place the API key in
# the Flutter app or pass it to the client.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=

# Bearer secret the Flutter app will NOT have; this is for operator/local tooling only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPERATOR_TOKEN=

# ---------------------------------------------------------------------------
# Supabase (configure only after a real project and secure secret store exist).
# The service-role key is backend-only and bypasses RLS; API ownership checks are mandatory.
# ---------------------------------------------------------------------------
# Leave blank until a real project exists. The data layer sits behind an
# interface, so Milestone 1 runs with the in-memory adapter when these are empty.
# API authentication is backend-managed (scrypt passwords and tokens signed with
# LOCAL_JWT_SECRET). Email ownership verification/recovery are also backend-managed
# through EMAIL_PROVIDER; Supabase Auth sessions are not implemented.
AUTH_DRIVER=custom
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Retention policy (build (1).md §10.1) - enforced by the retention job AND
# published on the public privacy page. Change them together or the published
# policy stops describing real behaviour.
# ---------------------------------------------------------------------------
RETENTION_TRANSCRIPT_DAYS=90
RETENTION_EVALUATION_DAYS=90
RETENTION_USAGE_MONTHS=24
RETENTION_CONSENT_MONTHS_AFTER_WITHDRAWAL=36
RETENTION_PROFILE_GRACE_DAYS=30

# ---------------------------------------------------------------------------
# Public legal pages (/, /legal, /legal/privacy, /legal/terms, /legal/delete-account)
# ---------------------------------------------------------------------------
# Shown as the app name on the published policy and terms.
APP_NAME=Saudi English Tutor
# Monitored address for privacy questions and off-app deletion requests.
# Leave blank and the pages fall back to the in-app path instead of printing
# an empty "email us at" sentence. Required before store submission.
SUPPORT_EMAIL=
# Date the published text took effect (YYYY-MM-DD).
LEGAL_EFFECTIVE_DATE=2026-11-23

# ---------------------------------------------------------------------------
# Cost-control guardrails (read by the Milestone 0 validation harness)
# ---------------------------------------------------------------------------
# Hard ceiling for a single validation run, in HUMAIN credits. The harness
# refuses to start a run that could exceed this. 5000 = the current free tier.
VALIDATION_MAX_CREDITS=500
# Refuse to run if the account balance is at or below this.
VALIDATION_MIN_CREDITS_REMAINING=3000
