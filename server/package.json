{
  "name": "saudi-english-tutor-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend for Saudi English Tutor: auth, lessons, bounded speaking evaluation, HUMAIN voice orchestration, usage ledger.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:json": "node --test --test-reporter=tap \"tests/**/*.test.ts\"",
    "retention": "node src/runRetention.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.58.0",
    "express": "5.1.0",
    "socket.io-client": "4.8.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  }
}
